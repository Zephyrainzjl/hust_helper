{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hust-helper.local/schema/hust-eater-entry-1.0.json",
  "title": "HUST Eater Entry",
  "type": "object",
  "required": ["id", "name", "description", "source_pages", "source", "extensions"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "ordinal": {"type": "integer"},
    "category": {"type": "string"},
    "chapter_id": {"type": "string"},
    "section_id": {"type": "string"},
    "chapter_title": {"type": "string"},
    "section_title": {"type": "string"},
    "description": {"type": "string"},
    "source_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "recommended_items": {"type": "array", "items": {"type": "string"}},
    "media_ids": {"type": "array", "items": {"type": "string"}},
    "author_visit_status": {"type": "string"},
    "venue_type": {"type": "string"},
    "meal_periods": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object"},
    "user_editable": {"type": "boolean"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": true
}
